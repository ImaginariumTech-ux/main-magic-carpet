# Resend API Key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Recipient email where form responses will be delivered
CONTACT_RECEIVER_EMAIL=business@magiccarpet.studio

# Sender email address
# For local dev / testing before domain verification, use:
# CONTACT_FROM_EMAIL=Magic Carpet Website <onboarding@resend.dev>
# For production once magiccarpet.studio domain is verified in Resend:
# CONTACT_FROM_EMAIL=Magic Carpet Website <contact@magiccarpet.studio>
CONTACT_FROM_EMAIL=Magic Carpet Website <onboarding@resend.dev>
